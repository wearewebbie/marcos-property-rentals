<!-- F&Q Section -->
<section class="py-[100px] bg-eggshell" id="faqs">
  <div class="container">
    <div class="flex flex-col gap-[40px]">
      <h2 class="heading-2-bold text-navy" data-reveal>
        Frequently Asked Questions
      </h2>
      <div class="relative">
        <div class="flex flex-col">
          {% for faq in faqsTenant.slice(0, 8) %}
          <details
            class="group py-[20px] border-b border-black"
            data-reveal
            {%
            if
            loop.index0
            %
            5
            !="0"
            %}data-reveal-delay="{{ (loop.index0 % 5) * 60 }}"
            {%
            endif
            %}
          >
            <summary
              class="cursor-pointer list-none flex flex-row justify-between items-center gap-[20px]"
            >
              <span class="heading-6-bold text-navy">{{ faq.question }}</span>
              <span
                class="text-[32px] leading-none group-open:rotate-45 transition-transform duration-300 ease-in-out text-navy"
                >+</span
              >
            </summary>
            <p class="pt-[10px] text-navy">{{ faq.answer }}</p>
          </details>
          {% endfor %} {% if faqsTenant.length > 8 %}
          <input type="checkbox" id="expandFaqsTenant" class="peer hidden" />
          <div id="faqsTenantClip" class="max-h-0 overflow-hidden">
            {% for faq in faqsTenant.slice(8) %}
            <details class="group py-[20px] border-b border-black">
              <summary
                class="cursor-pointer list-none flex flex-row justify-between items-center gap-[20px]"
              >
                <span class="heading-6-bold text-navy">{{ faq.question }}</span>
                <span
                  class="text-[32px] leading-none group-open:rotate-45 transition-transform duration-300 ease-in-out text-navy"
                  >+</span
                >
              </summary>
              <p class="pt-[10px] text-navy">{{ faq.answer }}</p>
            </details>
            {% endfor %}
          </div>
          {% endif %}
        </div>
        {% if faqsTenant.length > 8 %}
        <div
          class="pointer-events-none absolute bottom-[64px] left-0 w-full h-[100px] bg-gradient-to-t from-eggshell to-transparent peer-checked:hidden"
        ></div>
        <label
          for="expandFaqsTenant"
          class="flex justify-center py-[20px] cursor-pointer peer-checked:rotate-180"
        >
          <span class="sr-only">Show all questions</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-[24px] h-[24px]"
            fill="#121212"
            viewBox="0 0 256 256"
          >
            <path
              d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z"
            ></path>
          </svg>
        </label>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var checkbox = document.getElementById("expandFaqsTenant");
    var clip = document.getElementById("faqsTenantClip");
    if (!checkbox || !clip) return;
    checkbox.addEventListener("change", function () {
      clip.style.maxHeight = checkbox.checked ? clip.scrollHeight + "px" : "";
    });
  })();
</script>


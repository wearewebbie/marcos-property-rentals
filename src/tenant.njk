<!-- Listings Section -->
<section class="py-[100px] bg-navy" id="listings">
  <div class="container">
    {% if collections.listings and collections.listings.length > 0 %}
    <div class="flex flex-col gap-[40px]">
      <div class="flex flex-col gap-[10px]" data-reveal>
        <h2 class="heading-2-bold text-eggshell capitalize">Listings</h2>
        <p class="body-normal text-eggshell">
          Browse properties and find your next home.
        </p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-[40px]">
        {% for listing in collections.listings %}
        <a
          href="{{ listing.url }}"
          class="flex flex-col group bg-eggshell p-[20px] gap-[20px] transition-transform duration-300 hover:-translate-y-[10px]"
          data-reveal
          data-reveal-delay="{{ (loop.index0 % 3) * 100 }}"
        >
          <div class="relative overflow-hidden h-[240px]">
            {% if listing.data.images and listing.data.images.length > 0 %} {%
            image listing.data.images[0].url, listing.data.images[0].alt,
            "w-full h-full object-cover" %} {% endif %}
            <span
              class="absolute top-[10px] left-[10px] small-medium bg-peach text-navy px-[10px] py-[5px]"
              >{{ listing.data.status | replace("_", " ") | title }}</span
            >
          </div>
          <div class="flex flex-col gap-[15px] flex-1">
            <div class="flex flex-col gap-[5px]">
              <h3 class="heading-6-bold text-navy">
                {{ listing.data.address.street }}, {{ listing.data.address.city
                }}
              </h3>
              <p class="small-normal text-navy">
                {{ listing.data.address.county }}, {{
                listing.data.address.postcode }}
              </p>
            </div>
            <div
              class="flex flex-row gap-[15px] small-normal text-navy border-t border-b border-navy py-[10px]"
            >
              <p>{{ listing.data.bedrooms }} bed</p>
              <p>{{ listing.data.bathrooms }} bath</p>
              <p>{{ listing.data.receptions }} reception</p>
            </div>
            <p class="heading-6-bold text-navy">
              £{{ listing.data.price }}<span class="small-normal">/mo</span>
            </p>
            <span
              class="button-primary-peach text-center transition-colors duration-300 group-hover:bg-peach group-hover:text-eggshell"
              >View Property</span
            >
          </div>
        </a>
        {% endfor %}
      </div>
    </div>
    {% else %}
    <div class="flex flex-col gap-[40px]">
      <h2 class="heading-2-bold text-eggshell">Available Properties</h2>
      <p class="text-eggshell">
        There are currently no listings available. Please check back soon.
      </p>
    </div>
    {% endif %}
  </div>
</section>

<!-- How to Apply Section -->
<section class="py-[100px] bg-eggshell" id="how-to-apply">
  <div class="container">
    <div class="flex flex-col items-center gap-[40px] text-center">
      <h2 class="heading-2-bold text-navy" data-reveal>How to Apply</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-[40px]">
        <div
          class="flex flex-col items-center gap-[10px] text-center"
          data-reveal
        >
          <p class="heading-3-bold text-peach">1</p>
          <h3 class="heading-6-bold text-navy">Book a Viewing</h3>
          <p class="body-normal text-navy">
            Viewing the property gives you the chance to explore the property,
            ask questions, and make sure it meets your needs before applying.
          </p>
        </div>
        <div
          class="flex flex-col items-center gap-[10px] text-center"
          data-reveal
          data-reveal-delay="100"
        >
          <p class="heading-3-bold text-peach">2</p>
          <h3 class="heading-6-bold text-navy">Apply</h3>
          <p class="body-normal text-navy">
            Send us your application and we'll take care of the identity,
            income, and reference verification process for you.
          </p>
        </div>
        <div
          class="flex flex-col items-center gap-[10px] text-center"
          data-reveal
          data-reveal-delay="200"
        >
          <p class="heading-3-bold text-peach">3</p>
          <h3 class="heading-6-bold text-navy">Move In</h3>
          <p class="body-normal text-navy">
            Once approved, we'll prepare your tenancy agreement and arrange a
            convenient date to collect your keys and move.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>


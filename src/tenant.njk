        <form
          action="https://submit-form.com/lZuuo0xd8"
          method="POST"
          class="flex flex-col gap-[20px]"
        >
          <div class="flex flex-col gap-[5px]">
            <label for="name" class="form-label text-eggshell"
              >Full Name*</label
            >
            <input
              type="text"
              id="name"
              name="name"
              class="form-input border-eggshell"
              placeholder="Jane Smith"
              required
            />
          </div>
          <div class="flex flex-col gap-[5px]">
            <label for="email" class="form-label text-eggshell">Email*</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form-input border-eggshell"
              placeholder="jane@example.com"
              required
            />
          </div>
          <div class="flex flex-col gap-[5px]">
            <label for="message" class="form-label text-eggshell"
              >Message*</label
            >
            <textarea
              id="message"
              name="message"
              rows="4"
              class="form-input border-eggshell"
              placeholder="Tell us what you're looking for..."
              required
            ></textarea>
          </div>
          <input
            type="hidden"
            name="_redirect"
            value="{{ site.url }}/success/"
          />
          <button type="submit" class="button-primary-peach self-end">
            Submit
          </button>
        </form>

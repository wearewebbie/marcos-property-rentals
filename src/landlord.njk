<script>
    (function () {
        var checkbox = document.getElementById("expandComparisonTable");
        var clip = document.getElementById("comparisonTableClip");
        if (!checkbox || !clip) return;
        checkbox.addEventListener("change", function () {
            clip.style.maxHeight = checkbox.checked ? clip.scrollHeight + "px" : "";
        });
    })();

    document.addEventListener("DOMContentLoaded", function () {
        var packageSelect = document.getElementById("package");
        if (!packageSelect) return;
        document.querySelectorAll(".enquire-package-btn").forEach(function (btn) {
            btn.addEventListener("click", function () {
                packageSelect.value = btn.dataset.package;
            });
        });
    });
</script>

